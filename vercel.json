{
  "installCommand": "echo 'static site: nothing to install'",
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/ai-assistant.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
